//User and Profile Data Models

model User {
    id String @id @default(cuid(2)) //Generates User ID
    email String @unique
    phoneNumber String @unique
    createdAt DateTime @default(now())
    profile Profile? //Tells Prisma how to fetch a user's Profile in queries

    //Relation Link: Tracks incidents that are logged for this user
    incidents Incident[]
}

model Profile {
    id String @id @default(cuid(2)) //Generates Profile ID
    firstName String?
    lastName String?

    //Foreign key, stores copied id string to link tables
    userId String @unique
    
    //Relational mapping: Links the Profile table's userId to the User table's id
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)  
}
