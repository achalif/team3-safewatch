//Restricts user permission levels
enum Role {
  USER
  ADMIN
}

//Restricts active tracking status
enum UserStatus {
  ONLINE //App is open, low-power location updates
  OFFLINE //User is not using the app
  IN_TRANSIT //"Walk home" mode active, regular high-precision GPS updates
  EMERGENCY //Panic triggered, highest-frequency GPS stream + contact alerts
}

//User and Profile Data Models

model User {
    id String @id @default(cuid(2)) //Generates User ID
    email String @unique
    phoneNumber String @unique
    role Role @default(USER)

    password String //Stores hashed password
    
    //Virtually links a user to their corresponding profile (so it can be queried via TypeScript)
    profile Profile?

    
    emergencyContacts EmergencyContact[] //User's emergency contacts
    alertsTriggered AlertLog[] //History of panic alerts fired by the user


    //Timestamps
    createdAt DateTime @default(now) //Automatically records the date/time a record was first created
    updatedAt DateTime @updatedAt //Updates current date everytime a specific record is modified

    //Verification flags
    isEmailVerified Boolean @default(false)
    isPhoneVerified Boolean @default(false)


}

model Profile {
    id String @id @default(cuid(2)) //Generates Profile ID
    firstName String?
    lastName String?

    //Dynamic GPS coordinates
    latitude Float?
    longitude Float?
    lastLocationUpdate DateTime?

    //GPS hardware control flags
    status UserStatus @default(OFFLINE)
    isActiveTracking Boolean @default(false)

    //Hardware and Notification State
    batteryLevel Int?
    pushToken String? //Push token for instant mobile alerts (for incidents)

    //Timestamp
    updatedAt Datetime @updatedAt

    userId String @unique //Foreign key, stores copied id string to link tables
    
    //Relational mapping: Links the Profile table's userId to the User table's id
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    //Spatial index: Ensures the database only retrieves incidents within the range
    //of the user profile's longitude and latitude
    @@index([latitude, longitude])
}
