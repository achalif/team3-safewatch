//Global Configuration & Connection

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Restricts emergency contact categories
enum EmergencyContact {
  PARENT
  SPOUSE
  SIBLING
  FRIEND
  OTHER
}
